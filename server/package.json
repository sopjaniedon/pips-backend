{
  "name": "@pips/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PIPS API: public site rendering, content/forms API, admin API",
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma": "node --env-file=../.env ./node_modules/prisma/build/index.js",
    "gen:secrets": "tsx src/cli/gen-secrets.ts",
    "db:migrate": "node --env-file=../.env ./node_modules/prisma/build/index.js migrate dev",
    "user:create-admin": "tsx --env-file=../.env src/cli/create-admin.ts",
    "test:matrix": "tsx --env-file=../.env src/cli/test-db.ts && node --env-file=../.env ./node_modules/vitest/vitest.mjs run --config vitest.matrix.config.ts",
    "files:gc": "tsx --env-file=../.env src/cli/files-gc.ts",
    "pii:rekey": "tsx --env-file=../.env src/cli/pii-rekey.ts"
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.3.0",
    "@prisma/client": "^6.5.0",
    "argon2": "^0.44.0",
    "fastify": "^5.2.1",
    "he": "^1.2.0",
    "heic-convert": "^2.1.0",
    "nodemailer": "^7.0.13",
    "sanitize-html": "^2.18.0",
    "sharp": "^0.34.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/he": "^1.2.3",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^8.0.2",
    "@types/sanitize-html": "^2.16.2",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
