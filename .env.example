# Copy to .env (never commit .env). Generate secrets with: pnpm --filter @pips/server gen:secrets
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:8080

# PostgreSQL (docker compose service "postgres", bound to 127.0.0.1)
POSTGRES_USER=pips
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pips
POSTGRES_PORT=5433
DATABASE_URL=postgresql://pips:change-me@localhost:5433/pips

# Sessions and personal-data encryption (AES-256-GCM). PII_KEYS = JSON {"<kid>":"<base64 32 bytes>"}
SESSION_SECRET=change-me-64-random-chars
PII_KEYS={"k1":"REPLACE_WITH_BASE64_32_BYTES"}
PII_ACTIVE_KID=k1

# File storage (gitignored)
STORAGE_DIR=./data/storage

# Email: capture = everything goes to Mailpit (http://localhost:8025). live is only allowed in production.
MAIL_MODE=capture
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="PIPS <no-reply@pips-ks.org>"

# Legacy DNN source (read-only). Paths are outside the repo.
LEGACY_BAK_DIR=/absolute/path/to/_DataBase
LEGACY_BAK_FILE=Pips-ks.org13.10.2026.bak
LEGACY_PORTALS_DIR=/absolute/path/to/Pips-ks.org - Copy/Portals
LEGACY_MSSQL_PORT=14334
LEGACY_SA_PASSWORD=change-me-Strong1!
LEGACY_READER_PASSWORD=change-me-Reader1!
